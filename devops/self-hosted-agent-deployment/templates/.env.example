# ============================================================================
# Self-hosted agent — environment template
# ============================================================================
# Copy this to `.env`, paste in real values, then `docker compose up`.
#
# Treat this file like a credential: chmod 600, never commit, never paste
# into a chat message or screenshot.
# ============================================================================

# ---- Host UID/GID for the non-root remap inside the container. -------------
# On a typical Ubuntu cloud VM the SSH user is `ubuntu` with UID/GID 1000.
# The container remaps the in-image non-root user to these, so files in
# /opt/data stay owned correctly on the host.
AGENT_UID=1000
AGENT_GID=1000

# ---- Primary LLM (OpenAI-compatible). -------------------------------------
# Plug in whichever provider you'd use locally.
LLM_BASE_URL=https://api.venice.ai/api/v1
LLM_API_KEY=***_n
LLM_MODEL=minimax-m3

# ---- Backup LLM (OpenAI-compatible). --------------------------------------
# Same shape; pick a `:free` slug from OpenRouter's catalog.
LLM_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
LLM_FALLBACK_API_KEY=YOUR_O...n
LLM_FALLBACK_MODEL=meta-llama/llama-4-maverick:free

# ---- Chat interface (Telegram is the cheapest, lightest). --------------------
# Create via @BotFather → /newbot.  Paste the bot token here.  Comma-separated
# numeric chat IDs in TELEGRAM_ALLOWED_CHATS (positive for DMs, negative for
# groups).
TELEGRAM_BOT_TOKEN=***_n
TELEGRAM_ALLOWED_CHATS=

# ---- Managed Postgres (operational state, NOT the agent's primary memory). -
# Format: postgresql://USER:***@HOST/DB?sslmode=require
DATABASE_URL=

# ---- Cloudflare tunnel. ----------------------------------------------------
TUNNEL_ID=
TUNNEL_HOSTNAME=agent.example.com
# Path inside the cloudflared container, mounted from ./tunnel/credentials.json
TUNNEL_CREDENTIALS_FILE=/etc/cloudflared/credentials.json
