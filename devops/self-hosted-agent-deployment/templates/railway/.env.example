# Railway-side .env.example
#
# Copy to .env, fill in real values, chmod 600, source before
# pushing env vars to Railway via `railway variables set`.
#
# IMPORTANT: this file is NOT shipped to Railway as-is. The
# Railway runtime reads the `railway variables` set you've
# declared, then entrypoint.sh shell-substitutes them into
# `~/.hermes/.env` at container start. Think of this file as
# the staging area on YOUR local machine that feeds `railway variables set`,
# not the final secret store.

# --- LLM (Venice by default; port to Anthropic / OpenRouter by editing cli-config.yaml) ---
VENICE_API_KEY=VENICE_INFERENCE_KEY_...

# --- Telegram channel ---
# Create via @BotFather /newbot; numeric user ID via @userinfobot
TELEGRAM_BOT_TOKEN=...:AA...
TELEGRAM_ALLOWED_USERS=...        # comma-separated numeric IDs; same as HOME_CHANNEL for personal DM
TELEGRAM_HOME_CHANNEL=...         # gotcha #6 — if unset, the bot is silently idle
TELEGRAM_HOME_CHANNEL_NAME=...    # display name; for convenience only

# --- Hermes runtime tuning ---
HERMES_HUMAN_DELAY_MODE=natural   # natural cadence between Telegram replies
HERMES_ACCEPT_HOOKS=1             # accept webhooks from external systems

# --- Optional: webhook mode (more efficient than polling at scale) ---
# TELEGRAM_WEBHOOK_URL=https://<svc>.up.railway.app/telegram
# TELEGRAM_WEBHOOK_SECRET=$(openssl rand -hex 32)

# --- Optional: MCP servers ---
# NOTION_TOKEN=secret_...
# MY_MCP_TOKEN=bearer_...
